# Copy to .env.local and edit. All NEXT_PUBLIC_* vars are exposed to the browser.

# Default network on first load (mainnet | testnet | devnet-paloma | any custom
# devnet name added in Settings). devnet-paloma's quorum service is currently
# unreachable. Persisted per-user via localStorage. Can also be selected at
# runtime via the ?network=<name> URL parameter.
NEXT_PUBLIC_DEFAULT_NETWORK=testnet

# Trusted quorum service for Mainnet / Testnet (quorum public keys and the DAPI
# masternode list). Empty uses https://quorums.<network>.networks.dash.org.
# Must be https:// (http:// only for localhost); other values are ignored with a
# console warning.
# Users can override this in Settings → Connection. There is no untrusted mode
# (NEXT_PUBLIC_TRUSTED_MODE was removed), and explicit DAPI address lists are
# not offered for these networks: point at another quorum service instead.
NEXT_PUBLIC_QUORUM_URL_MAINNET=
NEXT_PUBLIC_QUORUM_URL_TESTNET=

# Read-only deployment: /broadcast and /wallet show a "write mode is disabled"
# notice, and every link into them (sidebar Write group, owner shortcuts, token
# actions, vote links) is hidden.
NEXT_PUBLIC_DISABLE_WRITE_MODE=false

# DASH/USD rate provider: coinbase | kucoin | none. Defaults to coinbase.
# KuCoin's public API sends no CORS headers, so browsers block it and log a
# console error on every page load; `kucoin` only works behind a proxy that adds
# them, and otherwise falls back to Coinbase.
NEXT_PUBLIC_RATE_PROVIDER=coinbase

# Optional URL to load an extended well-known registry (JSON).
NEXT_PUBLIC_WELL_KNOWN_URL=

# External identity creation and top-up (Mainnet and Testnet). HTTPS base URL,
# without a query string or fragment. The shipped default is bridge.dashhq.org.
# Set empty to disable these shortcuts. Changes require a fresh build.
NEXT_PUBLIC_BRIDGE_URL=https://bridge.dashhq.org

# Offline service worker. `off` stops registering it, removes one installed by
# an earlier deploy, and ships an unregistering sw.js (see README → Hardening).
NEXT_PUBLIC_SERVICE_WORKER=on

# Path prefix for project-site hosting, e.g. /native-platform-explorer. Empty
# serves from the root (the explorer.dashhq.org custom domain).
NEXT_PUBLIC_BASE_PATH=
